{
  "name": "dsh-mcp-manager",
  "version": "0.3.0",
  "private": true,
  "description": "MCP manager for the DeepSeek Harness Desktop: add/edit/remove MCP servers, paste mcpServers JSON, test connectivity, and discover host-configured MCP servers",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iswilliamleeya/dsh-mcp-manager.git"
  },
  "homepage": "https://github.com/iswilliamleeya/dsh-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/iswilliamleeya/dsh-mcp-manager/issues"
  },
  "files": [
    "lib/",
    "install/",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "dsh": {
    "plugin": {
      "inject": [
        "tools"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  }
}
